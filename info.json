{
  "identifier": "com.libowen.bob-universal-processor",
  "version": "0.2.2",
  "category": "translate",
  "name": "通用 AI 处理器",
  "summary": "基于自定义提示词处理任意文本（代码解释、总结、分析、转换等），支持划词与 OCR 后处理",
  "icon": "",
  "author": "gray0128",
  "homepage": "https://github.com/gray0128/bob-Universal-Plugin",
  "repository": "https://github.com/gray0128/bob-Universal-Plugin",
  "minBobVersion": "1.15.0",
  "options": [
    {
      "identifier": "serviceProvider",
      "type": "menu",
      "title": "服务提供商",
      "defaultValue": "deepseek",
      "menuValues": [
        { "title": "DeepSeek（推荐 R1 思考模型）", "value": "deepseek" },
        { "title": "OpenAI（含 o1/o3/o4 系列）", "value": "openai" },
        { "title": "Claude（Anthropic 3.7/4 思考）", "value": "claude" },
        { "title": "通义千问（Qwen3/QwQ 思考）", "value": "qwen" },
        { "title": "Gemini（Google 2.5 思考）", "value": "gemini" },
        { "title": "Ollama（本地模型）", "value": "ollama" },
        { "title": "其他 OpenAI Compatible", "value": "openai-compatible" }
      ],
      "desc": "选择对应的大模型厂商，插件会自动适配其思考参数格式"
    },
    {
      "identifier": "apiUrl",
      "type": "text",
      "title": "API Base URL",
      "defaultValue": "https://api.deepseek.com/v1",
      "textConfig": {
        "type": "visible"
      },
      "desc": "会根据服务提供商自动建议常用地址，也可手动填写"
    },
    {
      "identifier": "apiKey",
      "type": "text",
      "title": "API Key",
      "textConfig": {
        "type": "secure"
      },
      "desc": "对应服务的 API Key。本地模型（Ollama）可留空"
    },
    {
      "identifier": "model",
      "type": "text",
      "title": "模型名称",
      "defaultValue": "deepseek-reasoner",
      "textConfig": {
        "type": "visible"
      },
      "desc": "DeepSeek 推荐 deepseek-reasoner；Qwen 推荐 qwen3-32b 或 qwq-32b；Claude 推荐 claude-3-7-sonnet-20250219"
    },
    {
      "identifier": "presetTemplate",
      "type": "menu",
      "title": "内置处理模板",
      "defaultValue": "code_explainer",
      "menuValues": [
        { "title": "代码深度解释（推荐）", "value": "code_explainer" },
        { "title": "代码安全审计", "value": "code_security" },
        { "title": "技术文章 / 文档提炼要点", "value": "text_summary" },
        { "title": "生成知识卡片", "value": "knowledge_card" },
        { "title": "代码添加高质量中文注释", "value": "add_comments" },
        { "title": "Bug 分析与修复建议", "value": "bug_analysis" },
        { "title": "自定义提示词（高级）", "value": "custom" }
      ],
      "desc": "选择内置模板后无需填写下方 System/User Prompt。选「自定义」才使用下方配置。"
    },
    {
      "identifier": "thinkingLevel",
      "type": "menu",
      "title": "思考等级",
      "defaultValue": "medium",
      "menuValues": [
        { "title": "关闭思考（最快）", "value": "off" },
        { "title": "低强度（快速响应）", "value": "low" },
        { "title": "中等强度（推荐）", "value": "medium" },
        { "title": "高强度（深度思考）", "value": "high" },
        { "title": "自动（由模型决定）", "value": "auto" }
      ],
      "desc": "控制模型思考过程的强度。DeepSeek-R1、Qwen3、Claude 3.7、Gemini 2.5、o1/o3 等模型支持。"
    },
    {
      "identifier": "thinkingBudget",
      "type": "text",
      "title": "思考预算 Tokens（高级）",
      "defaultValue": "",
      "textConfig": {
        "type": "visible"
      },
      "desc": "留空则根据思考等级自动分配。仅 Claude/Gemini/Qwen 有效，格式为数字（如 4096）"
    },
    {
      "identifier": "systemPrompt",
      "type": "text",
      "title": "System Prompt（仅自定义模式）",
      "defaultValue": "",
      "textConfig": {
        "type": "visible",
        "height": 80,
        "placeholderText": "仅当「内置处理模板」选择「自定义提示词」时生效"
      },
      "desc": "仅当「内置处理模板」选择「自定义提示词」时生效"
    },
    {
      "identifier": "userPromptTemplate",
      "type": "text",
      "title": "User Prompt 模板（仅自定义模式）",
      "defaultValue": "",
      "textConfig": {
        "type": "visible",
        "height": 80,
        "placeholderText": "必须包含 $text 占位符"
      },
      "desc": "仅当「内置处理模板」选择「自定义提示词」时生效。必须包含 $text 占位符"
    },
    {
      "identifier": "temperature",
      "type": "text",
      "title": "Temperature",
      "defaultValue": "0.3",
      "textConfig": {
        "type": "visible"
      },
      "desc": "思考模型建议保持 0.1~0.4，创意任务可提高"
    },
    {
      "identifier": "maxTokens",
      "type": "text",
      "title": "Max Tokens",
      "defaultValue": "4000",
      "textConfig": {
        "type": "visible"
      },
      "desc": "输出最大长度，思考模型建议设置较大值"
    },
    {
      "identifier": "stream",
      "type": "menu",
      "title": "流式输出",
      "defaultValue": "enable",
      "menuValues": [
        { "title": "启用（推荐）", "value": "enable" },
        { "title": "禁用", "value": "disable" }
      ]
    }
  ]
}
